# 1. ADMIN CREDENTIALS
# Master password for admin superuser login in /PAINELRESTAURANTE
ADMIN_PASSWORD=admin123

# 2. CLOUDINARY CLOUD STORAGE
# Direct CDN image upload for menu item photos and restaurant banners
CLOUDINARY_CLOUD_NAME=nqnutmc7
CLOUDINARY_API_KEY=87211716892821
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. CORS CONFIGURATION
# Allowed origins for cross-domain requests (comma-separated or single domain)
CORS_ORIGINS=https://tokioinbox.onrender.com

# 4. SUPABASE POSTGRESQL INTEGRATION
# Database URL and secure service role key for order archiving and customer syncing
SUPABASE_URL=https://ojztmcnghgsrvstmasnc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# 5. SERVER TIMEZONE
# Canonical timezone for order timestamps, audit logs, and thermal printing
TZ=America/Sao_Paulo

# 6. PORT (Render automatically assigns e.g. 10000; defaults to 3000 locally)
PORT=10000

# 7. GOOGLE GEMINI AI
# Intelligent Sommelier, culinary pairing recommendations and CMV insights
